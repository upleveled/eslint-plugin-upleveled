{
  "name": "eslint-plugin-upleveled",
  "version": "3.0.0",
  "repository": "upleveled/eslint-plugin-upleveled",
  "license": "MIT",
  "author": "UpLeveled (https://github.com/upleveled)",
  "contributors": [
    "José Fernando Höwer Barbosa <josehowerupn@gmail.com>",
    "Karl Horky <karl.horky@gmail.com>"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "rules/*.js"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm build && node --import ./rules/rule-tester-setup.ts --test",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@typescript-eslint/rule-tester": "catalog:",
    "@typescript-eslint/types": "catalog:",
    "@typescript-eslint/typescript-estree": "8.71.0",
    "@typescript-eslint/utils": "catalog:",
    "eslint": "10.11.0",
    "eslint-config-upleveled": "10.0.4",
    "eslint-plugin-upleveled": "2.1.15",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
